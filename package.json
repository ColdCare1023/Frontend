{
  "name": "frontend-cadena-frio",
  "private": true,
  "version": "1.0.0",
  "description": "Dashboard web de monitoreo IoT de cadena de frío farmacéutica — Tesis UPC 2026",
  "type": "module",
  "scripts": {
    "dev": "vite --mode backend",
    "dev:demo": "vite --mode demo",
    "dev:backend": "cross-env VITE_MODO_DEMO=false vite",
    "build": "tsc -b && vite build --mode backend",
    "build:demo": "tsc -b && vite build --mode demo",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "lint": "eslint src/ e2e/ playwright.config.ts",
    "lint:fix": "eslint src/ --fix",
    "csp:demo": "node scripts/generar-vercel-json.mjs",
    "csp:prod": "node scripts/generar-vercel-json.mjs",
    "verificar:bundle": "node scripts/verificar-bundle-produccion.mjs dist"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "i18next": "^24.2.2",
    "lucide-react": "^0.474.0",
    "motion": "^13.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.4.0",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.1"
  }
}
