# ColdCare · variables del frontend. Copia este archivo a `.env.local`
# (ignorado por git) y descomenta solo lo que necesites. Aquí no van secretos:
# todo lo que empieza por VITE_ termina dentro del JavaScript publicado.

# --- Local contra el backend real y los sensores (`npm run dev`) -------------
# Vite reenvía /api, incluido el flujo SSE de lecturas, a este backend: el
# navegador no sale de localhost y no hay CORS que configurar.
# Por defecto: http://localhost:8000 (uvicorn del backend).
# COLDCARE_BACKEND_URL=https://<servicio>.up.railway.app

# --- Backend en otro origen, sin proxy (builds publicados) -------------------
# Exige CORS_ORIGINS en el backend y su origen en la CSP (ver DESPLIEGUE.md).
# Vacío: mismo origen (proxy de Vite en local).
# VITE_API_BASE_URL=https://<servicio>.up.railway.app

# Flujo SSE en un origen distinto al de la API. Por defecto <API>/api/sse/lecturas.
# VITE_SSE_URL=

# Acceso con Google. Sin él, el login no lo ofrece.
# VITE_GOOGLE_CLIENT_ID=

# Publicación bajo una subruta (Vercel, junto a la landing).
# VITE_APP_BASE=/app/
